DATABASE_URL=postgresql://outbox:outbox@localhost:5433/outbox
REDIS_URL=redis://localhost:6379
PORT=4000
NEXTAUTH_SECRET=replace-with-a-long-random-secret-shared-with-frontend
FRONTEND_URL=http://localhost:3000

# Worker tuning
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# Optional: pre-created Ethereal credentials (auto-created if omitted)
# ETHEREAL_USER=
# ETHEREAL_PASS=

# Override these for a reachable SMTP provider.
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_CONNECTION_TIMEOUT_MS=10000

# Set to "true" on Railway (or any PaaS that blocks outbound SMTP port 587).
# Uses nodemailer's jsonTransport — no network call, no SMTP handshake.
# All scheduling, BullMQ, rate-limiting and DB persistence still work fully.
# Local dev: leave unset (or false) to use real Ethereal SMTP.
# SIMULATE_EMAIL=true
